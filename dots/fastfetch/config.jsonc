
// Part of it was made by @erin_1.

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/Guita.png",
    "type": "kitty-direct",
    "width": 45,
    "padding": {
      "top": 3,
      "bottom": 0,
    },
  },
  "display": {
    "separator": " ➜  ",
  },
  "modules": [
    "break",
    "break",
    "break",
    {
      "type": "os",
      "key": "OS   ",
      "keyColor": "31",
      "keyWidth": 10,
    },
    {
      "type": "kernel",
      "key": " ├  ",
      "keyColor": "31",
      "keyWidth": 10,
    },
    {
      "type": "command",
      "key": " ├  ",
      "keyColor": "31",
      "keyWidth": 10,
      "text": "echo Generation $(readlink /nix/var/nix/profiles/system | grep -o '[0-9]\\+')",
    },
    {
      "type": "shell",
      "key": " └  ",
      "keyColor": "31",
      "keyWidth": 10,
    },
    "break",
    {
      "type": "wm",
      "key": "WM   ",
      "keyColor": "32",
      "keyWidth": 10,
    },
    {
      "type": "wmtheme",
      "key": " ├ 󰉼 ",
      "keyColor": "32",
      "keyWidth": 10,
    },
    {
      "type": "icons",
      "key": " ├ 󰀻 ",
      "keyColor": "32",
      "keyWidth": 10,
    },
    {
      "type": "cursor",
      "key": " ├  ",
      "keyColor": "32",
      "keyWidth": 10,
    },
    {
      "type": "terminal",
      "key": " ├  ",
      "keyColor": "32",
      "keyWidth": 10,
    },
    {
      "type": "terminalfont",
      "key": " └  ",
      "keyColor": "32",
      "keyWidth": 10,
    },
    "break",
    {
      "type": "host",
      "format": "{5} {1} Type {2}",
      "key": "PC   ",
      "keyColor": "33",
      "keyWidth": 10,
    },
    {
      "type": "cpu",
      "format": "{1}",
      "key": " ├  ",
      "keyColor": "33",
      "keyWidth": 10,
    },
    {
      "type": "gpu",
      "format": "{1} {2}",
      "key": " ├ 󰢮 ",
      "keyColor": "33",
      "keyWidth": 10,
    },
    {
      "type": "memory",
      "key": " ├  ",
      "keyColor": "33",
      "keyWidth": 10,
    },
    {
      "type": "swap",
      "key": " ├ 󰓡 ",
      "keyColor": "33",
      "keyWidth": 10,
    },
    {
      "type": "disk",
      "key": " ├ 󰋊 ",
      "keyColor": "33",
      "keyWidth": 10,
    },
    {
      "type": "monitor",
      "format": "{2}x{3} @ {6}\" & {11} hz",
      "key": " └  ",
      "keyColor": "33",
      "keyWidth": 10,
    },
    "break",
    "break",
  ],
}
