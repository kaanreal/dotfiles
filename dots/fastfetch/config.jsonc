{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "~/.config/fastfetch/Mori-idle.png",
    "type": "kitty-icat",
    "width": 30,
    "height": 20,
    "padding": {
      "top": 1,
      "bottom": 0,
      "left": 2,
    },
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "title",
    },
  },

  "modules": [
    "break",
    "break",

    {
      "type": "os",
      "key": "  󰣇 OS",
      "keyColor": "#D4C4A8",
      "keyWidth": 10,
    },
    {
      "type": "kernel",
      "key": "  ├ ",
      "keyColor": "#CCBA9C",
      "keyWidth": 10,
    },
    {
      "type": "command",
      "key": "  │ ",
      "keyColor": "#C4A882",
      "keyWidth": 10,
      "text": "echo 󰏗 Gen $(readlink /nix/var/nix/profiles/system | grep -o '[0-9]\\+')",
    },
    {
      "type": "shell",
      "key": "  └ ",
      "keyColor": "#BAA078",
      "keyWidth": 10,
    },

    "break",

    {
      "type": "uptime",
      "key": "  󰔛 up",
      "keyColor": "#B5956A",
      "keyWidth": 10,
    },
    {
      "type": "packages",
      "key": "  └ ",
      "keyColor": "#AA8A5E",
      "keyWidth": 10,
    },

    "break",

    {
      "type": "wm",
      "key": "  󰉼 WM",
      "keyColor": "#A67B5B",
      "keyWidth": 10,
    },
    {
      "type": "wmtheme",
      "key": "  ├ ",
      "keyColor": "#9D7050",
      "keyWidth": 10,
    },
    {
      "type": "icons",
      "key": "  ├ ",
      "keyColor": "#956748",
      "keyWidth": 10,
    },
    {
      "type": "cursor",
      "key": "  ├ ",
      "keyColor": "#8C5E42",
      "keyWidth": 10,
    },
    {
      "type": "terminal",
      "key": "  ├ ",
      "keyColor": "#84553C",
      "keyWidth": 10,
    },
    {
      "type": "terminalfont",
      "key": "  └ ",
      "keyColor": "#7C4D38",
      "keyWidth": 10,
    },

    "break",

    {
      "type": "host",
      "format": "{5} {1} {2}",
      "key": "  󰍹 PC",
      "keyColor": "#D4C4A8",
      "keyWidth": 10,
    },
    {
      "type": "cpu",
      "format": "{1} @ {3} GHz",
      "key": "  ├ ",
      "keyColor": "#C4A882",
      "keyWidth": 10,
    },
    {
      "type": "gpu",
      "format": "{1} {2}",
      "key": "  ├ ",
      "keyColor": "#B5956A",
      "keyWidth": 10,
    },
    {
      "type": "memory",
      "key": "  ├ ",
      "keyColor": "#A67B5B",
      "keyWidth": 10,
    },
    {
      "type": "swap",
      "key": "  ├ ",
      "keyColor": "#9D7050",
      "keyWidth": 10,
    },
    {
      "type": "disk",
      "key": "  ├ ",
      "keyColor": "#8C5E42",
      "keyWidth": 10,
    },
    {
      "type": "monitor",
      "format": "{2}x{3} @ {6}\" {11}Hz",
      "key": "  └ ",
      "keyColor": "#7C4D38",
      "keyWidth": 10,
    },

    "break",
    "break",
  ],
}
